{
  "expo": {
    "name": "HooperAI",
    "slug": "hooperai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0a0a0a"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0a0a"
      },
      "package": "com.hooperai.app",
      "permissions": [
        "CAMERA"
      ]
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.hooperai.app",
      "infoPlist": {
        "NSCameraUsageDescription": "HooperAI needs the camera to track shots in real time."
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "HooperAI needs the camera to record your shooting sessions.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "HooperAI needs access to your videos to analyze shooting sessions.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-font"
    ]
  }
}
