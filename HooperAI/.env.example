# Copy to HooperAI/.env (never commit .env). Restart `npx expo start` after editing.

# Laptop server used until you change it in the app's Settings.
# Same Wi-Fi: the laptop's LAN IP. Away from home: its Tailscale IP (100.x.y.z).
EXPO_PUBLIC_SERVER_URL=http://192.168.1.100:8000

# Firebase web app config (Firebase console → Project settings → Your apps → Web app).
# Leave empty to run without sign-in (API key mode). These values are public by design.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
