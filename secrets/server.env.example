# Copy to secrets/server.env (git-ignored). Read by scripts/app/server.py at start.

# Listen on all interfaces so the phone can connect (Wi-Fi or Tailscale).
HOOPER_HOST=0.0.0.0
HOOPER_PORT=8000

# Until Firebase is set up: a shared secret the app sends as X-API-Key
# (enter the same value in the app's Settings). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
HOOPER_API_KEY=

# After Firebase is set up: path to the service-account JSON (Project settings →
# Service accounts → Generate new private key). Takes precedence over the API key.
# FIREBASE_CREDENTIALS=C:\Users\fridr\Documents\HooperAI\secrets\firebase-adminsdk.json
