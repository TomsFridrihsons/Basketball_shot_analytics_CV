# Git LFS tracking for large files
*.pt filter=lfs diff=lfs merge=lfs -text
*.pth filter=lfs diff=lfs merge=lfs -text
*.onnx filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.avi filter=lfs diff=lfs merge=lfs -text

# Text files
*.md text eol=lf
*.py text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.txt text eol=lf
*.json text eol=lf

# Binary files
*.jpg binary
*.png binary
*.jpeg binary
*.gif binary
*.zip binary
# Git hooks run under sh: keep LF
scripts/git-hooks/* text eol=lf
*.sh text eol=lf
